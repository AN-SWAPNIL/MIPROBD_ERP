{
  "name": "medical-supplier-erp-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-environment.mjs",
    "dev:backend": "node scripts/run-environment.mjs",
    "dev:staging": "node scripts/run-environment.mjs staging",
    "dev:uat": "node scripts/run-environment.mjs uat",
    "check:environment": "node scripts/run-environment.mjs --check",
    "dev:api": "node scripts/run-environment.mjs --api-only",
    "dev:server": "npm run dev:api",
    "server": "node scripts/run-environment.mjs --api-only",
    "dev:web": "node scripts/run-environment.mjs --web-only",
    "build": "node scripts/check-deployment-profile.mjs && tsc -b && npm run typecheck:api && vite build",
    "typecheck:api": "tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "pretest": "node --test scripts/environment-profile.test.mjs && npm run test:production-hardening && npm run test:update13 && npm run test:quality-backend && npm run test:vercel-routing",
    "test:production-hardening": "tsx --test server/environment.test.ts server/maintenance/maintenance.test.ts server/opening/reader.test.ts server/trading/pages.test.ts server/trading/pages.hosted.test.ts",
    "test:vercel-routing": "tsx --test server/vercel-request.test.ts",
    "test:quality-backend": "tsx --test server/quality/quality.test.ts server/foundation/attachment-files.test.ts",
    "test:update13": "tsx --test server/controls/owner-authority.hosted.test.ts server/foundation/backups.test.ts server/foundation/invitation-outbox.test.ts server/foundation/invitation-outbox.hosted.test.ts server/foundation/runtime.test.ts server/foundation/runtime.hosted.test.ts server/operations/paging.test.ts server/operations/paging.hosted.test.ts server/operations/holds.test.ts server/operations/holds.hosted.test.ts server/operations/stock-controls.test.ts server/operations/stock-controls.hosted.test.ts server/opening/opening.test.ts server/opening/hosted.test.ts server/opening/posting.hosted.test.ts server/trading/overview.hosted.test.ts server/ledger/ledger.test.ts server/ledger/hosted.test.ts server/ledger/concurrency.hosted.test.ts server/returns/returns.test.ts server/returns/hosted.test.ts server/payroll/payroll.test.ts server/payroll/hosted.test.ts server/claims/claims.test.ts server/claims/hosted.test.ts",
    "test:payroll-backend": "tsx --test server/payroll/payroll.test.ts server/payroll/hosted.test.ts",
    "test:supplier-claims-backend": "tsx --test server/claims/claims.test.ts server/claims/hosted.test.ts",
    "test:returns-backend": "tsx --test server/returns/returns.test.ts server/returns/hosted.test.ts",
    "test:stock-controls-backend": "tsx --test server/operations/stock-controls.test.ts server/operations/stock-controls.hosted.test.ts",
    "test:stock-holds-backend": "tsx --test server/operations/holds.test.ts server/operations/holds.hosted.test.ts",
    "test:ledger-backend": "tsx --test server/ledger/ledger.test.ts server/ledger/hosted.test.ts server/ledger/concurrency.hosted.test.ts",
    "backend:runtime-database": "node scripts/run-environment.mjs --tool scripts/runtime-database.ts",
    "backend:invitations": "node scripts/run-environment.mjs --tool scripts/invitation-worker.ts",
    "backend:opening-profile": "node scripts/run-environment.mjs --tool scripts/opening-profile.ts",
    "backend:opening-storage": "node scripts/run-environment.mjs --tool scripts/opening-storage.ts",
    "test": "tsx --test src/utils/precise.test.ts src/lib/auth/queryScope.test.ts src/domains/imports/costing.test.ts src/lib/permissions/effectiveAccess.test.ts src/domains/employees/employeeReports.test.ts src/domains/reports/reportFilters.test.ts server/salesWorkspace.test.ts server/runtime-mode.test.ts server/foundation/foundation.test.ts server/foundation/security.test.ts server/foundation/security.hosted.test.ts server/operations/operations.test.ts server/operations/hosted.test.ts server/trading/trading.test.ts server/trading/hosted.test.ts server/trading/transactions.hosted.test.ts server/finance/finance.test.ts server/finance/hosted.test.ts server/printing/printing.test.ts server/printing/hosted.test.ts server/reports/reports.test.ts server/reports/hosted.test.ts server/reports/reconciliation.hosted.test.ts server/workforce/workforce.test.ts server/workforce/hosted.test.ts server/workforce/visits.test.ts server/workforce/visits.hosted.test.ts server/dashboard/dashboard.test.ts server/dashboard/hosted.test.ts",
    "test:allocation": "tsx --test src/domains/imports/costing.test.ts",
    "check:backend": "node scripts/run-environment.mjs --tool scripts/backend-readiness.mjs",
    "check:release": "tsx scripts/release-check.ts",
    "prepare:scheduled-deployment": "node scripts/prepare-job-config.mjs",
    "cleanup:test-artifacts": "powershell -NoProfile -File scripts/cleanup-test-artifacts.ps1",
    "smoke:invitations": "node scripts/invitation-controls-smoke.mjs",
    "db:generate": "node scripts/run-environment.mjs --tool node_modules/drizzle-kit/bin.cjs generate",
    "db:backup": "node scripts/run-environment.mjs --tool scripts/database.ts backup",
    "db:verify": "node scripts/run-environment.mjs --tool scripts/migration-integrity.ts",
    "backend:storage-backup": "node scripts/run-environment.mjs --tool scripts/storage-backup.ts",
    "backend:verify-backups": "node scripts/run-environment.mjs --tool scripts/verify-backups.ts",
    "db:migrate": "node scripts/run-environment.mjs --tool scripts/database.ts migrate",
    "backend:bootstrap": "node scripts/run-environment.mjs --tool scripts/backend-bootstrap.ts",
    "backend:cleanup-tests": "node scripts/run-environment.mjs --tool scripts/backend-test-cleanup.ts",
    "test:backend": "tsx --test server/foundation/foundation.test.ts",
    "test:imports-backend": "tsx --test server/operations/operations.test.ts server/operations/hosted.test.ts",
    "test:sales-backend": "tsx --test server/trading/trading.test.ts server/trading/hosted.test.ts server/trading/transactions.hosted.test.ts",
    "test:finance-backend": "tsx --test server/finance/finance.test.ts server/finance/hosted.test.ts",
    "test:print-backend": "tsx --test server/printing/printing.test.ts server/printing/hosted.test.ts",
    "test:reports-backend": "tsx --test server/reports/reports.test.ts server/reports/hosted.test.ts server/reports/reconciliation.hosted.test.ts",
    "check:print-layout": "node scripts/run-environment.mjs --tool scripts/print-layout-check.ts",
    "test:workforce-backend": "tsx --test server/workforce/workforce.test.ts server/workforce/hosted.test.ts",
    "test:visits-backend": "tsx --test server/workforce/visits.test.ts server/workforce/visits.hosted.test.ts",
    "test:dashboard-backend": "tsx --test server/dashboard/dashboard.test.ts server/dashboard/hosted.test.ts",
    "test:security-backend": "tsx --test server/foundation/security.test.ts server/foundation/security.hosted.test.ts",
    "backend:visit-cleanup": "node scripts/run-environment.mjs --tool scripts/visit-evidence-cleanup.ts",
    "check:visits": "node scripts/run-environment.mjs --tool scripts/visit-readiness.ts",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.0",
    "clsx": "^2.1.1",
    "cookie": "1.0.2",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "fflate": "0.8.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.23.0",
    "pg": "8.23.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
    "recharts": "3.10.1",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.61.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "supabase": "2.122.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.16"
  }
}
