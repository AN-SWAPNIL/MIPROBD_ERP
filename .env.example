# Keep blank for same-origin Vercel API deployment.
VITE_API_BASE_URL=

# Enable only on controlled prototype deployments that may expose mock role identities.
VITE_DEMO_MODE=false

# Server-side equivalent for local or split deployments.
DEMO_MODE=false
# Only for an intentionally isolated public prototype deployment, never a real ERP.
DEMO_DEPLOYMENT=false

# Real backend source: prototype-only code lives on the prototype branch.
# npm run dev selects the correct ignored credential file for the checked-out branch.
# For client UAT/production explicitly set BOTH modes to foundation, demo flags
# false and APP_URL to that environment's HTTPS URL. Do not reuse the dev DB.
ERP_BACKEND_MODE=foundation
VITE_BACKEND_MODE=foundation
APP_URL=http://localhost:5178
# Optional local MFA rehearsal. Production/Vercel always requires privileged MFA.
ERP_REQUIRE_MFA=false

# Server-only scheduled invitation worker and authenticated health monitor.
# Keep disabled in development/UAT unless outbound mail is explicitly intended.
ERP_SCHEDULED_JOBS_ENABLED=false
# Optional sanitized method/route-template/status/duration logs; no bodies or queries.
ERP_LOG_REQUESTS=false
# Generate a unique random value (at least 32 characters) for each environment.
# CRON_SECRET=REPLACE_WITH_A_STRONG_SERVER_ONLY_SECRET

# Used by the opt-in foundation backend, not by the in-memory prototype.
# Use this as a reference for the selected ignored artifacts/private/*.env file.
# Root .env and .env.local are intentionally not loaded.
# Never commit real credentials or place server secrets in VITE_* variables.

# Supabase Dashboard > Connect > Transaction pooler (runtime, port 6543).
# Copy the actual pooler host. URL-encode the password (for example, # becomes %23).
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres"
# Production uses the restricted role, never the broad postgres migration identity.
# Optional LOCAL isolation for a second environment; use paths under artifacts/private.
# ERP_ENV_FILE=artifacts/private/uat.env
# ERP_RUNTIME_ENV_FILE=artifacts/private/uat-runtime.env
# ERP_BOOTSTRAP_DIR=artifacts/private/uat-owner
# Provision locally with npm run backend:runtime-database -- --apply.
# Copy the generated server-only value from artifacts/private/runtime-database.env to staging secrets.
# DATABASE_RUNTIME_URL="postgresql://mipro_runtime.PROJECT_REF:GENERATED_PASSWORD@POOLER_HOST:6543/postgres"
# Deployed runtime needs only this restricted URI (or DATABASE_URL pointing to the same restricted role).
# Never put the migration/admin database URI in the web runtime environment.
# Local opt-in. Production/Vercel always enforces restricted runtime privileges.
ERP_REQUIRE_RESTRICTED_DB=false
# Optional strict local rehearsal. Production always requires a Super Admin-approved GL mapping.
# Do not enable until chart, cutover, cash mappings and approval authorities are configured.
ERP_REQUIRE_LEDGER_CONFIGURATION=false

# Supabase Dashboard > Connect > Session pooler (migrations, port 5432).
# A direct connection URI can be used instead when IPv6 is available.
DATABASE_MIGRATION_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres"

# Server-only Supabase configuration. Use plain URLs, not Markdown links.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Optional: this endpoint can be derived from SUPABASE_URL.
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Public browser authentication configuration: same project and publishable key.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional public build settings shared by office and recorded check-in raster maps.
# Defaults work without a Google/API key; retain attribution and provider terms.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
# Never put a secret provider credential in VITE_*; these values are public.

# One-time administrator bootstrap; no administrator password in this file.
SUPER_ADMIN_NAME="Example Administrator"
SUPER_ADMIN_EMAIL=admin@example.com
