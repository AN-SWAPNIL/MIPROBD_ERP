# Keep blank for same-origin Vercel API deployment.
VITE_API_BASE_URL=

# Enable only on controlled prototype deployments that may expose mock role identities.
VITE_DEMO_MODE=true

# Server-side equivalent for local or split deployments.
DEMO_MODE=true
DEMO_DEPLOYMENT=true
ERP_BACKEND_MODE=mock
VITE_BACKEND_MODE=mock
